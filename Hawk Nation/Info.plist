<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background app refresh (R-1): one look at the favorites' live
	     games per wake, for alerts, the widget and Live Activities. Spelled
	     out rather than built from the bundle id, so a re-signed sideload
	     keeps it matching `BackgroundRefresh.identifier`. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>PolarReailty.Hawk-Nation.scoreboard-refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<!-- The brand themes' app icons (`BrandTheme.appIconName`, switched by
	     `AppIconSwitcher`): each key and CFBundleIconName is the name of an
	     AppIcon-<Name>.appiconset in Assets.xcassets, which
	     ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES compiles. The primary
	     icon, the classic theme's, stays `AppIcon`. -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>AppIcon-Cobalt</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Cobalt</string>
			</dict>
			<key>AppIcon-Sky</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Sky</string>
			</dict>
			<key>AppIcon-Teal</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Teal</string>
			</dict>
			<key>AppIcon-Green</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Green</string>
			</dict>
			<key>AppIcon-Gold</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Gold</string>
			</dict>
			<key>AppIcon-Orange</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Orange</string>
			</dict>
			<key>AppIcon-Red</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Red</string>
			</dict>
			<key>AppIcon-Pink</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Pink</string>
			</dict>
			<key>AppIcon-Purple</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Purple</string>
			</dict>
			<key>AppIcon-Graphite</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Graphite</string>
			</dict>
		</dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>AppIcon-Cobalt</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Cobalt</string>
			</dict>
			<key>AppIcon-Sky</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Sky</string>
			</dict>
			<key>AppIcon-Teal</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Teal</string>
			</dict>
			<key>AppIcon-Green</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Green</string>
			</dict>
			<key>AppIcon-Gold</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Gold</string>
			</dict>
			<key>AppIcon-Orange</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Orange</string>
			</dict>
			<key>AppIcon-Red</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Red</string>
			</dict>
			<key>AppIcon-Pink</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Pink</string>
			</dict>
			<key>AppIcon-Purple</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Purple</string>
			</dict>
			<key>AppIcon-Graphite</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Graphite</string>
			</dict>
		</dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- The widget's tap-through links, myteams://team/<TeamRef.id>. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>myteams</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>myTeams adds your team’s remaining games to a calendar of their own, and reads back only the games it added so it can move rescheduled ones instead of adding them twice.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>myTeams adds the games you choose to your calendar, with the kickoff time, venue and channel. It never reads your other events.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- The brand logo centred on LaunchscreenColor. The `logosmall` image
	     this once named never existed in Assets.xcassets, so nothing drew;
	     `myTeamsLogo` does exist, with light and dark variants matching the
	     colour's white and black. SplashView redraws the same in SwiftUI. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchscreenColor</string>
		<key>UIImageName</key>
		<string>myTeamsLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
